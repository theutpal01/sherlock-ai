{
  "comment": "No rule may conclude guilty(X): possibility is not proof (enforced by the loader).",
  "rules": [
    {
      "id": "R_ACCESS_001",
      "description": "A person possessing the matching key can access the safe.",
      "conditions": [
        {"name": "has_key", "args": ["?person", "?key"]},
        {"name": "opens", "args": ["?key", "?container"]}
      ],
      "conclusion": {"name": "can_access", "args": ["?person", "?container"]}
    },
    {
      "id": "R_TIME_001",
      "description": "A bell logged at the moment of the disturbance marks the time of the crime.",
      "conditions": [
        {"name": "bell_rang", "args": ["?bell", "?time"]}
      ],
      "conclusion": {"name": "crime_time", "args": ["?time"]}
    },
    {
      "id": "R_PRINT_001",
      "description": "Fresh dust of a distinctive kind where someone walked places the wearer there at the crime time.",
      "conditions": [
        {"name": "dust_in", "args": ["?room", "?mark"]},
        {"name": "boot_matches", "args": ["?person", "?mark"]},
        {"name": "crime_time", "args": ["?time"]}
      ],
      "conclusion": {"name": "was_at", "args": ["?person", "?room", "?time"]}
    },
    {
      "id": "R_OPP_001",
      "description": "Presence in the dressing room at the crime time means opportunity.",
      "conditions": [
        {"name": "was_at", "args": ["?person", "dressing", "?time"]},
        {"name": "crime_time", "args": ["?time"]}
      ],
      "conclusion": {"name": "has_opportunity", "args": ["?person"]}
    },
    {
      "id": "R_OPP_002",
      "description": "Presence on the stage at the crime time means opportunity.",
      "conditions": [
        {"name": "was_at", "args": ["?person", "stage", "?time"]},
        {"name": "crime_time", "args": ["?time"]}
      ],
      "conclusion": {"name": "has_opportunity", "args": ["?person"]}
    },
    {
      "id": "R_MOTIVE_001",
      "description": "Owing money one cannot repay is a motive.",
      "conditions": [
        {"name": "owes_money", "args": ["?person", "?creditor"]}
      ],
      "conclusion": {"name": "has_motive", "args": ["?person"]}
    },
    {
      "id": "R_ALIBI_OTTO",
      "description": "Claiming the alley while present on the stage contradicts the alibi.",
      "conditions": [
        {"name": "claims_at", "args": ["?person", "alley", "?time"]},
        {"name": "was_at", "args": ["?person", "stage", "?time"]}
      ],
      "conclusion": {"name": "alibi_contradicted", "args": ["?person"]}
    },
    {
      "id": "R_ALIBI_VERA",
      "description": "Claiming the auditorium while present in the dressing room contradicts the alibi.",
      "conditions": [
        {"name": "claims_at", "args": ["?person", "auditorium", "?time"]},
        {"name": "was_at", "args": ["?person", "dressing", "?time"]}
      ],
      "conclusion": {"name": "alibi_contradicted", "args": ["?person"]}
    },
    {
      "id": "R_SUSPECT_003",
      "description": "Access plus opportunity plus motive marks a possible suspect — never guilt.",
      "conditions": [
        {"name": "can_access", "args": ["?person", "?container"]},
        {"name": "has_opportunity", "args": ["?person"]},
        {"name": "has_motive", "args": ["?person"]}
      ],
      "conclusion": {"name": "possible_suspect", "args": ["?person"]}
    },
    {
      "id": "R_SUSPECT_004",
      "description": "A contradicted alibi plus opportunity marks a possible suspect — never guilt.",
      "conditions": [
        {"name": "alibi_contradicted", "args": ["?person"]},
        {"name": "has_opportunity", "args": ["?person"]}
      ],
      "conclusion": {"name": "possible_suspect", "args": ["?person"]}
    },
    {
      "id": "R_MEANS_001",
      "description": "A lock opened with a key implicates whoever holds a matching key.",
      "conditions": [
        {"name": "opened_with_key", "args": ["?container"]},
        {"name": "has_key", "args": ["?person", "?key"]},
        {"name": "opens", "args": ["?key", "?container"]}
      ],
      "conclusion": {"name": "had_means", "args": ["?person", "?container"]}
    }
  ]
}
